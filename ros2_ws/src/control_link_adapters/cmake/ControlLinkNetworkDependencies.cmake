if(DEFINED _CONTROL_LINK_NETWORK_DEPENDENCIES_INCLUDED)
	return()
endif()
set(_CONTROL_LINK_NETWORK_DEPENDENCIES_INCLUDED TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/ControlLinkNetworkDependencyLock.cmake")

option(CONTROL_LINK_ENABLE_SOMEIP "Find optional vsomeip dependencies; adapters create the SOME/IP runtime targets" OFF)
option(CONTROL_LINK_ENABLE_GRPC "P0 gRPC/Protobuf dependency probe only; no production gRPC adapter" OFF)
option(CONTROL_LINK_ENABLE_MQTT "P0 Paho dependency probe only; no production MQTT adapter" OFF)

function(_control_link_require_target target_name)
	if(NOT TARGET "${target_name}")
		message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: required imported target ${target_name} is missing")
	endif()
endfunction()

function(_control_link_target_location target_name result_name)
	_control_link_require_target("${target_name}")
	get_target_property(location "${target_name}" IMPORTED_LOCATION)
	if(NOT location)
		get_target_property(configurations "${target_name}" IMPORTED_CONFIGURATIONS)
		foreach(configuration IN LISTS configurations)
			string(TOUPPER "${configuration}" configuration_upper)
			get_target_property(location "${target_name}" "IMPORTED_LOCATION_${configuration_upper}")
			if(location)
				break()
			endif()
		endforeach()
	endif()
	if(NOT location OR NOT EXISTS "${location}" OR IS_DIRECTORY "${location}")
		message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: ${target_name} has no existing imported library/tool: ${location}")
	endif()
	get_filename_component(location "${location}" REALPATH)
	set("${result_name}" "${location}" PARENT_SCOPE)
endfunction()

function(_control_link_exact_version package_name actual expected)
	if(NOT "${actual}" STREQUAL "${expected}")
		message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: ${package_name} version ${actual} does not match locked ${expected}")
	endif()
endfunction()

function(_control_link_record_file report_variable label location)
	file(SHA256 "${location}" digest)
	set("${report_variable}" "${${report_variable}}${label}.path=${location}\n${label}.sha256=${digest}\n" PARENT_SCOPE)
endfunction()

function(control_link_probe_network_dependencies)
	set(report "scope=DEPENDENCY_PROBE_ONLY\nproduction_protocol_targets=NONE\n")
	string(APPEND report "someip.enabled=${CONTROL_LINK_ENABLE_SOMEIP}\ngrpc.enabled=${CONTROL_LINK_ENABLE_GRPC}\nmqtt.enabled=${CONTROL_LINK_ENABLE_MQTT}\n")
	string(APPEND report "lock.vsomeip=${CONTROL_LINK_VSOMEIP_VERSION}\nlock.grpc=${CONTROL_LINK_GRPC_VERSION}\nlock.protobuf=${CONTROL_LINK_PROTOBUF_VERSION}\nlock.paho_cpp=${CONTROL_LINK_PAHO_CPP_VERSION}\nlock.paho_c=${CONTROL_LINK_PAHO_C_VERSION}\n")
	string(APPEND report "mosquitto.future_broker_only=${CONTROL_LINK_MOSQUITTO_VERSION}\n")

	if(CONTROL_LINK_ENABLE_SOMEIP)
		find_package(vsomeip3 ${CONTROL_LINK_VSOMEIP_VERSION} EXACT CONFIG QUIET)
		if(NOT vsomeip3_FOUND)
			message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: SOMEIP requires vsomeip3 CONFIG exactly ${CONTROL_LINK_VSOMEIP_VERSION}; missing/disabled/wrong version; considered=${vsomeip3_CONSIDERED_VERSIONS}")
		endif()
		_control_link_exact_version(vsomeip3 "${vsomeip3_VERSION}" "${CONTROL_LINK_VSOMEIP_VERSION}")
		_control_link_target_location(vsomeip3 vsomeip_library)
		get_filename_component(vsomeip_library_dir "${vsomeip_library}" DIRECTORY)
		unset(CONTROL_LINK_VSOMEIP_SD_LIBRARY CACHE)
		unset(CONTROL_LINK_VSOMEIP_SD_LIBRARY)
		find_library(CONTROL_LINK_VSOMEIP_SD_LIBRARY NAMES vsomeip3-sd PATHS "${vsomeip_library_dir}" NO_DEFAULT_PATH)
		if(NOT CONTROL_LINK_VSOMEIP_SD_LIBRARY OR NOT EXISTS "${CONTROL_LINK_VSOMEIP_SD_LIBRARY}")
			message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: vsomeip3 ${CONTROL_LINK_VSOMEIP_VERSION} requires installed vsomeip3-sd Service Discovery library beside ${vsomeip_library}")
		endif()
		get_filename_component(vsomeip_sd_real "${CONTROL_LINK_VSOMEIP_SD_LIBRARY}" REALPATH)
		get_filename_component(vsomeip_sd_dir "${vsomeip_sd_real}" DIRECTORY)
		if(NOT vsomeip_sd_dir STREQUAL vsomeip_library_dir)
			message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: vsomeip3-sd must share the current vsomeip3 library directory, not a stale prefix")
		endif()
		string(APPEND report "someip.status=DEPENDENCY_PROBE_ONLY\nsomeip.config=${vsomeip3_CONFIG}\nsomeip.version=${vsomeip3_VERSION}\n")
		_control_link_record_file(report vsomeip.library "${vsomeip_library}")
		_control_link_record_file(report vsomeip.service_discovery "${CONTROL_LINK_VSOMEIP_SD_LIBRARY}")
	endif()

	if(CONTROL_LINK_ENABLE_GRPC)
		find_package(gRPC ${CONTROL_LINK_GRPC_VERSION} EXACT CONFIG QUIET)
		if(NOT gRPC_FOUND)
			message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: GRPC requires gRPC CONFIG exactly ${CONTROL_LINK_GRPC_VERSION}; missing/disabled/wrong version; considered=${gRPC_CONSIDERED_VERSIONS}")
		endif()
		_control_link_exact_version(gRPC "${gRPC_VERSION}" "${CONTROL_LINK_GRPC_VERSION}")
		find_package(Protobuf ${CONTROL_LINK_PROTOBUF_VERSION} EXACT MODULE QUIET)
		if(NOT Protobuf_FOUND)
			message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: GRPC requires Protobuf exactly ${CONTROL_LINK_PROTOBUF_VERSION}, libprotobuf and protoc; found=${Protobuf_VERSION}")
		endif()
		_control_link_exact_version(Protobuf "${Protobuf_VERSION}" "${CONTROL_LINK_PROTOBUF_VERSION}")
		_control_link_target_location(gRPC::grpc++ grpc_library)
		_control_link_target_location(gRPC::grpc_cpp_plugin grpc_plugin)
		_control_link_target_location(protobuf::libprotobuf protobuf_library)
		_control_link_target_location(protobuf::protoc protobuf_compiler)
		execute_process(COMMAND "${protobuf_compiler}" --version RESULT_VARIABLE protoc_result OUTPUT_VARIABLE protoc_version ERROR_VARIABLE protoc_error OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 10)
		if(NOT protoc_result EQUAL 0 OR NOT protoc_version STREQUAL "libprotoc ${CONTROL_LINK_PROTOBUF_VERSION}")
			message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: protoc/header/library version mismatch; expected libprotoc ${CONTROL_LINK_PROTOBUF_VERSION}, got=${protoc_version}, exit=${protoc_result}, error=${protoc_error}")
		endif()
		set(probe_dir "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/control_link_grpc_dependency_probe")
		file(MAKE_DIRECTORY "${probe_dir}")
		file(WRITE "${probe_dir}/dependency_probe.proto" "syntax = \"proto3\"; package control_link_p0_probe; message State {} service Query { rpc Read(State) returns (State); }\n")
		execute_process(COMMAND "${protobuf_compiler}" "--proto_path=${probe_dir}" "--cpp_out=${probe_dir}" "--grpc_out=${probe_dir}" "--plugin=protoc-gen-grpc=${grpc_plugin}" "${probe_dir}/dependency_probe.proto" RESULT_VARIABLE generation_result OUTPUT_VARIABLE generation_output ERROR_VARIABLE generation_error TIMEOUT 10)
		if(NOT generation_result EQUAL 0 OR NOT EXISTS "${probe_dir}/dependency_probe.grpc.pb.cc" OR NOT EXISTS "${probe_dir}/dependency_probe.pb.cc")
			message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: locked gRPC::grpc_cpp_plugin/protoc generation check failed; exit=${generation_result}; ${generation_error}")
		endif()
		string(APPEND report "grpc.status=DEPENDENCY_PROBE_ONLY\ngrpc.config=${gRPC_CONFIG}\ngrpc.version=${gRPC_VERSION}\nprotobuf.version=${Protobuf_VERSION}\nprotoc.version=${protoc_version}\ngrpc.plugin_version_evidence=locked_package_export_and_successful_protoc_generation_not_a_version_cli\n")
		_control_link_record_file(report grpc.library "${grpc_library}")
		_control_link_record_file(report grpc.plugin "${grpc_plugin}")
		_control_link_record_file(report protobuf.library "${protobuf_library}")
		_control_link_record_file(report protobuf.protoc "${protobuf_compiler}")
	endif()

	if(CONTROL_LINK_ENABLE_MQTT)
		find_package(eclipse-paho-mqtt-c ${CONTROL_LINK_PAHO_C_VERSION} EXACT CONFIG QUIET)
		if(NOT eclipse-paho-mqtt-c_FOUND)
			message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: MQTT requires eclipse-paho-mqtt-c CONFIG exactly ${CONTROL_LINK_PAHO_C_VERSION}; missing/disabled/wrong version; considered=${eclipse-paho-mqtt-c_CONSIDERED_VERSIONS}")
		endif()
		_control_link_exact_version(eclipse-paho-mqtt-c "${eclipse-paho-mqtt-c_VERSION}" "${CONTROL_LINK_PAHO_C_VERSION}")
		find_package(EclipsePahoMqttCpp ${CONTROL_LINK_PAHO_CPP_VERSION} EXACT CONFIG QUIET)
		if(EclipsePahoMqttCpp_FOUND)
			set(paho_cpp_package EclipsePahoMqttCpp)
			set(paho_cpp_target EclipsePahoMqttCpp::paho-mqttpp3)
		else()
			find_package(PahoMqttCpp ${CONTROL_LINK_PAHO_CPP_VERSION} EXACT CONFIG QUIET)
			set(paho_cpp_package PahoMqttCpp)
			set(paho_cpp_target PahoMqttCpp::paho-mqttpp3)
		endif()
		if(NOT ${paho_cpp_package}_FOUND)
			message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: MQTT requires EclipsePahoMqttCpp or upstream PahoMqttCpp CONFIG exactly ${CONTROL_LINK_PAHO_CPP_VERSION}; missing/disabled/wrong version; considered=${EclipsePahoMqttCpp_CONSIDERED_VERSIONS};${PahoMqttCpp_CONSIDERED_VERSIONS}")
		endif()
		_control_link_exact_version("${paho_cpp_package}" "${${paho_cpp_package}_VERSION}" "${CONTROL_LINK_PAHO_CPP_VERSION}")
		_control_link_target_location("${paho_cpp_target}" paho_cpp_library)
		_control_link_target_location(PahoMqttC::PahoMqttC paho_c_library)
		set(paho_c_matches FALSE)
		foreach(c_target IN ITEMS eclipse-paho-mqtt-c::paho-mqtt3a eclipse-paho-mqtt-c::paho-mqtt3as)
			if(TARGET "${c_target}")
				_control_link_target_location("${c_target}" locked_c_library)
				if(locked_c_library STREQUAL paho_c_library)
					set(paho_c_matches TRUE)
				endif()
			endif()
		endforeach()
		if(NOT paho_c_matches)
			message(FATAL_ERROR "ControlLink P0 DEPENDENCY_PROBE_ONLY: PahoMqttC::PahoMqttC does not reference the locked ${CONTROL_LINK_PAHO_C_VERSION} asynchronous C export")
		endif()
		string(APPEND report "mqtt.status=DEPENDENCY_PROBE_ONLY\nmqtt.cpp_package=${paho_cpp_package}\nmqtt.cpp_target=${paho_cpp_target}\nmqtt.cpp_config=${${paho_cpp_package}_CONFIG}\nmqtt.c_config=${eclipse-paho-mqtt-c_CONFIG}\nmqtt.cpp_version=${${paho_cpp_package}_VERSION}\nmqtt.c_version=${eclipse-paho-mqtt-c_VERSION}\n")
		_control_link_record_file(report paho.cpp_library "${paho_cpp_library}")
		_control_link_record_file(report paho.c_library "${paho_c_library}")
	endif()

	file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/control_link_network_dependencies.txt" "${report}")
	message(STATUS "ControlLink P0 DEPENDENCY_PROBE_ONLY: SOMEIP=${CONTROL_LINK_ENABLE_SOMEIP}, GRPC=${CONTROL_LINK_ENABLE_GRPC}, MQTT=${CONTROL_LINK_ENABLE_MQTT}; no production protocol targets or runtime capability")
endfunction()
