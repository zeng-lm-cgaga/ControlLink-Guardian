<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
	<profiles>
		<transport_descriptors>
			<transport_descriptor>
				<transport_id>control_link_default_shm</transport_id>
				<type>SHM</type>
				<maxMessageSize>65500</maxMessageSize>
				<segment_size>16777216</segment_size>
				<port_queue_capacity>512</port_queue_capacity>
				<healthy_check_timeout_ms>1000</healthy_check_timeout_ms>
			</transport_descriptor>
			<transport_descriptor>
				<transport_id>control_link_default_udp</transport_id>
				<type>UDPv4</type>
				<maxMessageSize>65500</maxMessageSize>
			</transport_descriptor>
		</transport_descriptors>

		<participant profile_name="control_link_default_participant" is_default_profile="true">
			<rtps>
				<userTransports>
					<transport_id>control_link_default_shm</transport_id>
					<transport_id>control_link_default_udp</transport_id>
				</userTransports>
				<useBuiltinTransports>false</useBuiltinTransports>
			</rtps>
		</participant>
	</profiles>
</dds>
