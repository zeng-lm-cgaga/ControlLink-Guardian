@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost @Boost_VERSION_STRING@ EXACT COMPONENTS system thread filesystem)
find_dependency(vsomeip3 @CONTROL_LINK_VSOMEIP_VERSION@ EXACT CONFIG)
find_dependency(Protobuf @CONTROL_LINK_PROTOBUF_VERSION@ EXACT MODULE)
find_dependency(yaml-cpp)
find_dependency(Threads)
find_dependency(control_link_edge_protocol CONFIG)
set(control_link_someip_transport_SCHEMA_SHA256_HEX "@CONTROL_LINK_NETWORK_SCHEMA_SHA256_HEX@")
include("${CMAKE_CURRENT_LIST_DIR}/control_link_someip_transportTargets.cmake")
check_required_components(control_link_someip_transport)
