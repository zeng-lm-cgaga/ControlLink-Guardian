<?xml version="1.0"?>
<robot name="control_link_diffbot" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:arg name="wheel_separation" default="0.40"/>
	<xacro:arg name="wheel_radius" default="0.08"/>
	<xacro:arg name="left_wheel_joint" default="left_wheel_joint"/>
	<xacro:arg name="right_wheel_joint" default="right_wheel_joint"/>
	<xacro:arg name="controller_node_fqn" default="/diff_drive_controller"/>
	<xacro:arg name="odometry_topic" default="/odom"/>
	<xacro:arg name="base_footprint_frame" default="base_footprint"/>
	<xacro:arg name="base_link_frame" default="base_link"/>
	<xacro:arg name="laser_frame" default="laser_link"/>
	<xacro:arg name="controller_config" default=""/>
	<xacro:arg name="hardware_plugin" default="gz_ros2_control/GazeboSimSystem"/>
	<xacro:arg name="hardware_component_name" default="ControlLinkExecutionSystem"/>
	<xacro:arg name="use_mock_hardware" default="false"/>
	<xacro:arg name="mock_fail_read_after_cycles" default="0"/>
	<xacro:arg name="mock_fail_write_after_cycles" default="0"/>

	<xacro:property name="wheel_width" value="0.04"/>
	<xacro:property name="base_length" value="0.50"/>
	<xacro:property name="base_width" value="0.34"/>
	<xacro:property name="base_height" value="0.12"/>
	<xacro:property name="base_center_z" value="0.12"/>

	<material name="guardian_blue">
		<color rgba="0.10 0.35 0.70 1.0"/>
	</material>
	<material name="wheel_black">
		<color rgba="0.04 0.04 0.05 1.0"/>
	</material>
	<material name="sensor_gray">
		<color rgba="0.55 0.58 0.62 1.0"/>
	</material>

	<!-- base_footprint 是地面投影坐标系，不参与刚体动力学 -->
	<link name="$(arg base_footprint_frame)"/>

	<joint name="base_footprint_joint" type="fixed">
		<parent link="$(arg base_footprint_frame)"/>
		<child link="$(arg base_link_frame)"/>
		<origin xyz="0 0 ${base_center_z}" rpy="0 0 0"/>
	</joint>

	<link name="$(arg base_link_frame)">
		<inertial>
			<mass value="8.0"/>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<inertia ixx="0.0867" ixy="0" ixz="0" iyy="0.1763" iyz="0" izz="0.2430"/>
		</inertial>
		<visual>
			<geometry>
				<box size="${base_length} ${base_width} ${base_height}"/>
			</geometry>
			<material name="guardian_blue"/>
		</visual>
		<collision>
			<geometry>
				<box size="${base_length} ${base_width} ${base_height}"/>
			</geometry>
		</collision>
	</link>

	<xacro:macro name="drive_wheel" params="side joint_name y_offset">
		<joint name="${joint_name}" type="continuous">
			<parent link="$(arg base_link_frame)"/>
			<child link="${side}_wheel_link"/>
			<origin xyz="0 ${y_offset} ${-base_center_z + float($(arg wheel_radius))}" rpy="0 0 0"/>
			<axis xyz="0 1 0"/>
			<dynamics damping="0.1" friction="0.0"/>
		</joint>

		<link name="${side}_wheel_link">
			<inertial>
				<mass value="0.6"/>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<inertia ixx="0.00108" ixy="0" ixz="0" iyy="0.00192" iyz="0" izz="0.00108"/>
			</inertial>
			<visual>
				<origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
				<geometry>
					<cylinder radius="$(arg wheel_radius)" length="${wheel_width}"/>
				</geometry>
				<material name="wheel_black"/>
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
				<geometry>
					<cylinder radius="$(arg wheel_radius)" length="${wheel_width}"/>
				</geometry>
			</collision>
		</link>
	</xacro:macro>

	<xacro:drive_wheel
		side="left"
		joint_name="$(arg left_wheel_joint)"
		y_offset="${float($(arg wheel_separation)) / 2.0}"/>
	<xacro:drive_wheel
		side="right"
		joint_name="$(arg right_wheel_joint)"
		y_offset="${-float($(arg wheel_separation)) / 2.0}"/>

	<joint name="caster_joint" type="fixed">
		<parent link="$(arg base_link_frame)"/>
		<child link="caster_link"/>
		<origin xyz="-0.18 0 -0.08" rpy="0 0 0"/>
	</joint>
	<link name="caster_link">
		<inertial>
			<mass value="0.1"/>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<inertia ixx="0.000064" ixy="0" ixz="0" iyy="0.000064" iyz="0" izz="0.000064"/>
		</inertial>
		<visual>
			<geometry>
				<sphere radius="0.04"/>
			</geometry>
			<material name="sensor_gray"/>
		</visual>
		<collision>
			<geometry>
				<sphere radius="0.04"/>
			</geometry>
		</collision>
	</link>

	<joint name="laser_joint" type="fixed">
		<parent link="$(arg base_link_frame)"/>
		<child link="$(arg laser_frame)"/>
		<origin xyz="0.12 0 0.11" rpy="0 0 0"/>
	</joint>
	<link name="$(arg laser_frame)">
		<inertial>
			<mass value="0.2"/>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
		</inertial>
		<visual>
			<geometry>
				<cylinder radius="0.045" length="0.04"/>
			</geometry>
			<material name="sensor_gray"/>
		</visual>
		<collision>
			<geometry>
				<cylinder radius="0.045" length="0.04"/>
			</geometry>
		</collision>
	</link>

	<ros2_control name="$(arg hardware_component_name)" type="system">
		<hardware>
			<plugin>$(arg hardware_plugin)</plugin>
			<xacro:if value="$(arg use_mock_hardware)">
				<!-- joint 名和故障门由 launch 注入，URDF 不再拥有第二份运行配置 -->
				<param name="left_wheel_joint">$(arg left_wheel_joint)</param>
				<param name="right_wheel_joint">$(arg right_wheel_joint)</param>
				<param name="fail_read_after_cycles">$(arg mock_fail_read_after_cycles)</param>
				<param name="fail_write_after_cycles">$(arg mock_fail_write_after_cycles)</param>
			</xacro:if>
		</hardware>
		<joint name="$(arg left_wheel_joint)">
			<command_interface name="velocity"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
		</joint>
		<joint name="$(arg right_wheel_joint)">
			<command_interface name="velocity"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
		</joint>
	</ros2_control>

	<gazebo reference="$(arg laser_frame)">
		<sensor name="control_link_lidar" type="gpu_lidar">
			<topic>/scan</topic>
			<!-- Gazebo 默认使用作用域 sensor 名，显式绑定到 Profile 的 ROS frame -->
			<gz_frame_id>$(arg laser_frame)</gz_frame_id>
			<update_rate>10</update_rate>
			<always_on>true</always_on>
			<visualize>false</visualize>
			<lidar>
				<scan>
					<horizontal>
						<samples>360</samples>
						<resolution>1</resolution>
						<min_angle>-3.14159265359</min_angle>
						<max_angle>3.14159265359</max_angle>
					</horizontal>
				</scan>
				<range>
					<min>0.08</min>
					<max>12.0</max>
					<resolution>0.01</resolution>
				</range>
			</lidar>
		</sensor>
	</gazebo>

	<xacro:unless value="$(arg use_mock_hardware)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<robot_param>robot_description</robot_param>
				<robot_param_node>robot_state_publisher</robot_param_node>
				<parameters>$(arg controller_config)</parameters>
				<controller_manager_name>controller_manager</controller_manager_name>
				<ros>
					<!-- controller 的私有 odom Topic 映射到 Robot Profile 约定的执行反馈边界 -->
					<remapping>$(arg controller_node_fqn)/odom:=$(arg odometry_topic)</remapping>
				</ros>
			</plugin>
		</gazebo>
	</xacro:unless>
</robot>
